---
import linkIcon from 'lucide-static/icons/link.svg?raw';
import type { Project } from '../types/content';
import { githubIcon } from './brand-icons';
import Icon from './Icon.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class={project.closed ? 'opacity-60' : ''}>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    {
      project.image && (
        <img
          src={project.image}
          alt={project.title}
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
          class:list={[
            'h-16 w-16 shrink-0 rounded-xl',
            project.closed && 'grayscale',
          ]}
        />
      )
    }
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="font-bold text-2xl">
          {project.title}
          {
            project.closed && (
              <span class="ml-2 rounded-full border border-base/30 px-2 py-0.5 align-middle font-normal text-xs">
                Closed
              </span>
            )
          }
        </h3>
        <span class="ml-auto flex shrink-0 gap-2">
          {
            project.href && (
              <a
                href={project.href}
                aria-label={project.title}
                class="rounded-full bg-base/5 p-3"
                target="_blank"
                rel="noreferrer"
              >
                <Icon svg={linkIcon} size={15} />
              </a>
            )
          }
          {
            project.repositoryUrl && (
              <a
                href={project.repositoryUrl}
                rel="nofollow noreferrer"
                target="_blank"
                aria-label="Repository on GitHub"
                class="rounded-full bg-base/5 p-3"
              >
                <Icon svg={githubIcon} size={15} />
              </a>
            )
          }
        </span>
      </div>
      <p class="text-base">{project.description}</p>
      <ul class="mt-2 flex list-none flex-wrap gap-2">
        {
          project.stacks.map((stack) => (
            <li class="inline-block rounded-full border border-base/10 px-3 py-1 text-xs">
              {stack}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
