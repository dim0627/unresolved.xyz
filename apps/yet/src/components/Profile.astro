---
import { Content as Details } from '../content/profile-details.md';
import type { Profile } from '../types/content';
import SocialLinks from './SocialLinks.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<div class="py-24">
  <div>
    <div class="mb-6 flex items-center max-md:flex-col">
      <img
        src={profile.thumbnailUrl}
        alt={profile.fullName}
        width="128"
        height="128"
        class="mr-8 rounded-2xl shadow-bordered max-md:mr-0"
      />
      <div>
        <h1 class="font-semibold text-5xl max-md:mt-4">{profile.fullName}</h1>
        <div>{profile.description}</div>
      </div>
    </div>
    <SocialLinks profile={profile} />
  </div>
</div>
<div
  class="mt-12 [&_a]:underline [&_h2]:mt-8 [&_h2]:mb-4 [&_h2]:text-xl [&_ol]:[list-style:revert] [&_ol]:pl-6 [&_p]:my-4 [&_ul]:[list-style:revert] [&_ul]:pl-6"
>
  <Details />
</div>
